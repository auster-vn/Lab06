@model MedicalSuppliesCatalog.Lab06.ViewModels.DashboardViewModel
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
        <p class="text-muted">Medical Supplies Catalog — Lab06: Identity, Security, Audit & Observability</p>
    </div>
    @if ((await AuthorizationService.AuthorizeAsync(User, "CanManageProduct")).Succeeded)
    {
        <a asp-controller="Supplies" asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4">
            <i class="bi bi-plus-circle me-1"></i> Add Supply
        </a>
    }
</div>

<!-- Key Inventory Metrics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card text-center p-4">
            <i class="bi bi-boxes fs-1 text-primary"></i>
            <div class="fs-2 fw-bold text-primary mt-2">@Model.TotalSupplies</div>
            <small class="text-muted fw-semibold">Total Supplies</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card text-center p-4">
            <i class="bi bi-check-circle fs-1 text-success"></i>
            <div class="fs-2 fw-bold text-success mt-2">@Model.ActiveSupplies</div>
            <small class="text-muted fw-semibold">Active</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card text-center p-4">
            <i class="bi bi-trash fs-1 text-secondary"></i>
            <div class="fs-2 fw-bold text-secondary mt-2">@Model.DeletedSupplies</div>
            <small class="text-muted fw-semibold">In Trash</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card text-center p-4">
            <i class="bi bi-exclamation-triangle fs-1 text-warning"></i>
            <div class="fs-2 fw-bold text-warning mt-2">@(Model.OutOfStockCount + Model.LowStockCount)</div>
            <small class="text-muted fw-semibold">Need Attention</small>
        </div>
    </div>
</div>

<!-- Security Dashboard (Feature 3) & Financial Metrics -->
<div class="row g-3 mb-4">
    <!-- Security Metrics Card -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-shield-fill-exclamation me-2 text-warning"></i>Security Control Center</h5>
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <i class="bi bi-slash-circle fs-2 text-danger"></i>
                            <div class="fs-3 fw-bold text-danger mt-1">@Model.AccessDeniedToday</div>
                            <small class="text-muted fw-semibold d-block">Truy cập bị chặn</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <i class="bi bi-key-fill fs-2 text-info"></i>
                            <div class="fs-3 fw-bold text-info mt-1">@Model.SensitiveOpsToday</div>
                            <small class="text-muted fw-semibold d-block">Thao tác nhạy cảm</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <i class="bi bi-cloud-upload-fill fs-2 text-warning"></i>
                            <div class="fs-3 fw-bold text-warning mt-1">@Model.RejectedUploadsToday</div>
                            <small class="text-muted fw-semibold d-block">Tải file bị từ chối</small>
                        </div>
                    </div>
                </div>
                <div class="mt-3 small text-muted text-center">
                    <i class="bi bi-info-circle me-1"></i> Số liệu bảo mật được tính toán theo thời gian thực (hôm nay).
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Value Card -->
    <div class="col-md-5">
        <div class="card h-100 border-0 shadow-sm rounded-3 d-flex flex-column justify-content-between">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-secondary"><i class="bi bi-cash-stack me-2 text-success"></i>Inventory Value</h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">VALUED</span>
                </div>
                <div class="fs-3 fw-bold text-success my-3">@Model.TotalInventoryValue.ToString("N0") VND</div>
                <p class="text-muted small">Giá trị tổng lượng hàng hiện tại dựa trên đơn giá niêm yết của vật tư chưa bị xoá mềm.</p>
            </div>
            <div class="card-footer bg-light border-0 py-3 text-center rounded-bottom-3">
                <a asp-controller="Supplies" asp-action="Index" class="fw-semibold text-decoration-none">View Catalog details <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Navigation Links -->
<div>
    <h5 class="fw-bold mb-3"><i class="bi bi-link-45deg me-1"></i>Quick Links</h5>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Supplies" asp-action="Index" class="btn btn-outline-primary rounded-3 px-3">
            <i class="bi bi-list me-1"></i> View Supplies Catalog
        </a>
        @if ((await AuthorizationService.AuthorizeAsync(User, "CanManageProduct")).Succeeded)
        {
            <a asp-controller="Supplies" asp-action="Trash" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="bi bi-trash me-1"></i> View Trash (@Model.DeletedSupplies)
            </a>
        }
        @if ((await AuthorizationService.AuthorizeAsync(User, "CanViewAuditLog")).Succeeded)
        {
            <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-outline-dark rounded-3 px-3">
                <i class="bi bi-journal-text me-1"></i> Security Audit Logs
            </a>
        }
        <a href="/health/ready" class="btn btn-outline-success rounded-3 px-3">
            <i class="bi bi-heart-pulse me-1"></i> Health Status
        </a>
        <a href="/api/supplies/1" target="_blank" class="btn btn-outline-info rounded-3 px-3">
            <i class="bi bi-code-slash me-1"></i> API: Supply #1
        </a>
        <a href="/api/supplies/9999" target="_blank" class="btn btn-outline-danger rounded-3 px-3">
            <i class="bi bi-bug me-1"></i> API: 404 ProblemDetails
        </a>
        <a href="/api/supplies/search?keyword=" target="_blank" class="btn btn-outline-danger rounded-3 px-3">
            <i class="bi bi-exclamation-triangle me-1"></i> API: 400 Validation Error
        </a>
    </div>
</div>

@{
    int statusCode = (int)(ViewData["StatusCode"] ?? 404);
    ViewData["Title"] = $"Error {statusCode}";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card">
            <div class="card-body p-5">
                <div class="display-1 fw-bold text-muted">@statusCode</div>
                @if (statusCode == 404)
                {
                    <h3>Page Not Found</h3>
                    <p class="text-muted">The page you requested does not exist.</p>
                }
                else if (statusCode == 403)
                {
                    <h3>Access Denied</h3>
                    <p class="text-muted">You don't have permission to access this page.</p>
                }
                else
                {
                    <h3>Oops!</h3>
                    <p class="text-muted">Something went wrong on our end.</p>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
                    <i class="bi bi-house me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

@model AccountRegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill text-success" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold mt-2 text-dark">Đăng Ký</h2>
                    <p class="text-muted">Tạo tài khoản quản trị mới</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control rounded-3" placeholder="Nguyen Van A" />
                        <label asp-for="FullName">Họ và tên</label>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" />
                        <label asp-for="Email">Địa chỉ Email</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control rounded-3" placeholder="Password" />
                        <label asp-for="Password">Mật khẩu (tối thiểu 6 ký tự, gồm chữ số)</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="Confirm Password" />
                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-success rounded-3 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-person-plus me-2"></i> Đăng ký
                    </button>
                </form>

                <div class="text-center mt-4">
                    <p class="mb-0 text-secondary">Đã có tài khoản? <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold">Đăng nhập ngay</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model List<MedicalSuppliesCatalog.Lab06.ViewModels.RequestHistoryViewModel>

@{
    ViewData["Title"] = "Supply Issue History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold"><i class="bi bi-clock-history me-2"></i>Supply Issue History</h1>
        <p class="text-muted">Lịch sử cấp phát vật tư — chỉ đọc, dùng <code>AsNoTracking()</code></p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> New Request
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No supply requests yet. <a asp-action="Create">Create one!</a></div>
}
else
{
    @foreach (var req in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><code>@req.RequestCode</code> — @req.RequesterName (@req.Department)</span>
                <span>
                    <span class="badge bg-success">@req.Status</span>
                    <small class="text-muted ms-2">@req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                </span>
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Supply</th><th>Qty</th><th class="text-end">Unit Price</th><th class="text-end">Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var item in req.Items)
                        {
                            <tr>
                                <td>@item.SupplyName</td>
                                <td>@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N0") VND</td>
                                <td class="text-end">@((item.Quantity * item.UnitPrice).ToString("N0")) VND</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-dark">
                            <td colspan="3" class="text-end fw-bold">Total Amount</td>
                            <td class="text-end fw-bold">@req.TotalAmount.ToString("N0") VND</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

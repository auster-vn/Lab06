@model MedicalSuppliesCatalog.Lab06.ViewModels.RequestCreateViewModel

@{
    ViewData["Title"] = "Issue Medical Supply";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0"><i class="bi bi-cart-plus me-2"></i>Issue Medical Supply</h3>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Tạo yêu cầu cấp phát → Service → Transaction → trừ StockQuantity + rollback nếu lỗi
                </p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary"></div>

                    <div class="mb-3">
                        <label asp-for="RequesterName" class="form-label fw-semibold">Requester Name</label>
                        <input asp-for="RequesterName" class="form-control" placeholder="Enter requester name" />
                        <span asp-validation-for="RequesterName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold">Department</label>
                        <input asp-for="Department" class="form-control" placeholder="e.g. Emergency, ICU, Surgery" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MedicalSupplyId" class="form-label fw-semibold">Medical Supply</label>
                        <select asp-for="MedicalSupplyId" asp-items="ViewBag.Supplies" class="form-select">
                            <option value="">-- Select Supply --</option>
                        </select>
                        <span asp-validation-for="MedicalSupplyId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                        <input asp-for="Quantity" type="number" class="form-control" min="1" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i> Submit Request
                        </button>
                        <a asp-controller="Supplies" asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Show validation summary if it has content
        var summary = document.getElementById('validationSummary');
        if (summary && summary.querySelectorAll('li').length > 0) {
            summary.classList.remove('d-none');
        }
    </script>
}

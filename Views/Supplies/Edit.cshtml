@model MedicalSuppliesCatalog.Lab06.ViewModels.SupplyEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa vật tư";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow border-0 rounded-4">
            <div class="card-header bg-warning text-dark p-4 rounded-top-4">
                <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa vật tư — @Model.SupplyCode</h3>
            </div>
            
            <div class="card-body p-5">
                <div class="alert alert-info border-0 rounded-3 small mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <strong>Kiểm soát đồng thời (Concurrency Control):</strong> RowVersion được nhúng dưới dạng token ẩn.
                    Nếu có người dùng khác lưu thay đổi trước bạn, hệ thống sẽ báo lỗi và ngăn ghi đè (tránh lỗi Last Save Wins).
                </div>

                <div class="row g-5">
                    <!-- Left Column: Edit Form -->
                    <div class="col-md-7 border-end">
                        <form asp-controller="Supplies" asp-action="Edit" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

                            <!-- Hidden fields for identity and concurrency -->
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="RowVersionBase64" />
                            <input type="hidden" asp-for="ImagePath" />

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="SupplyCode" class="form-label fw-bold text-secondary">Mã vật tư <span class="text-danger">*</span></label>
                                    <input asp-for="SupplyCode" class="form-control text-uppercase rounded-3" />
                                    <span asp-validation-for="SupplyCode" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CategoryId" class="form-label fw-bold text-secondary">Danh mục vật tư <span class="text-danger">*</span></label>
                                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select rounded-3">
                                        <option value="">-- Chọn danh mục --</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="SupplyName" class="form-label fw-bold text-secondary">Tên vật tư y tế <span class="text-danger">*</span></label>
                                <input asp-for="SupplyName" class="form-control rounded-3" />
                                <span asp-validation-for="SupplyName" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Supplier" class="form-label fw-bold text-secondary">Nhà cung cấp <span class="text-danger">*</span></label>
                                <input asp-for="Supplier" class="form-control rounded-3" />
                                <span asp-validation-for="Supplier" class="text-danger small"></span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label asp-for="UnitPrice" class="form-label fw-bold text-secondary">Đơn giá (VND) <span class="text-danger">*</span></label>
                                    <input asp-for="UnitPrice" type="number" class="form-control rounded-3" min="0" />
                                    <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="StockQuantity" class="form-label fw-bold text-secondary">Số lượng tồn <span class="text-danger">*</span></label>
                                    <input asp-for="StockQuantity" type="number" class="form-control rounded-3" min="0" />
                                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="MinimumStock" class="form-label fw-bold text-secondary">Tồn tối thiểu <span class="text-danger">*</span></label>
                                    <input asp-for="MinimumStock" type="number" class="form-control rounded-3" min="0" />
                                    <span asp-validation-for="MinimumStock" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Description" class="form-label fw-bold text-secondary">Mô tả chi tiết</label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <!-- Quarantine Toggle -->
                            <div class="card border-warning border-opacity-50 rounded-3 mb-4">
                                <div class="card-header bg-warning bg-opacity-10 py-3">
                                    <h5 class="fw-bold mb-0 text-dark small"><i class="bi bi-shield-exclamation me-1"></i>Trạng thái cách ly kiểm chuẩn</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="checkbox" asp-for="IsQuarantined" id="chkQuarantined" />
                                        <label class="form-check-label fw-semibold text-secondary" for="chkQuarantined">
                                            Đưa vật tư vào cách ly
                                        </label>
                                    </div>
                                    <div class="mb-2" id="divQuarantineReason" style="display:none;">
                                        <label asp-for="QuarantineReason" class="form-label fw-bold text-secondary small">Lý do cách ly:</label>
                                        <input asp-for="QuarantineReason" class="form-control rounded-3" placeholder="Lý do cách ly..." />
                                        <span asp-validation-for="QuarantineReason" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 border-top pt-4">
                                <button type="submit" class="btn btn-warning text-dark rounded-3 px-4 fw-semibold shadow-sm">
                                    <i class="bi bi-save me-1"></i> Cập nhật chi tiết
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">Hủy bỏ</a>
                            </div>
                        </form>
                    </div>

                    <!-- Right Column: Image Display & Safe Image Upload Form -->
                    <div class="col-md-5">
                        <h5 class="fw-bold mb-3"><i class="bi bi-image me-1"></i>Ảnh vật tư y tế</h5>
                        
                        <!-- Image Preview -->
                        <div class="text-center p-3 bg-light rounded-3 border mb-4 shadow-sm">
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <img src="@Model.ImagePath" alt="@Model.SupplyName" class="img-fluid rounded border" style="max-height: 200px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="py-5 text-muted">
                                    <i class="bi bi-image fs-1 d-block mb-2"></i>
                                    <small>Chưa cấu hình hình ảnh</small>
                                </div>
                            }
                        </div>

                        <!-- Safe Image Upload Form (Feature 2) -->
                        <div class="card border-0 bg-light rounded-3">
                            <div class="card-body p-4">
                                <h6 class="fw-bold mb-2">Tải lên ảnh mới</h6>
                                <p class="text-muted small">Chỉ cho phép tệp: <strong>.jpg, .jpeg, .png, .webp</strong>. Kích thước tối đa: <strong>2MB</strong>.</p>
                                
                                <form asp-controller="Supplies" asp-action="UploadImage" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                                    <div class="mb-3">
                                        <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" class="form-control rounded-3" required />
                                    </div>
                                    <button type="submit" class="btn btn-outline-primary w-100 rounded-3 fw-semibold">
                                        <i class="bi bi-cloud-upload-fill me-1"></i> Tải lên và thay thế
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function toggleReason() {
                if ($("#chkQuarantined").is(":checked")) {
                    $("#divQuarantineReason").slideDown();
                    $("#QuarantineReason").attr("required", "required");
                } else {
                    $("#divQuarantineReason").slideUp();
                    $("#QuarantineReason").removeAttr("required");
                }
            }

            $("#chkQuarantined").change(toggleReason);
            toggleReason(); // run initially
        });
    </script>
}

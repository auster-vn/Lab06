@model List<MedicalSuppliesCatalog.Lab06.ViewModels.SupplyListItemViewModel>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Medical Supplies";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold"><i class="bi bi-box-seam me-2"></i>Danh mục Vật tư Y tế</h1>
        <p class="text-muted mb-0">Hiển thị các vật tư đang hoạt động (IsDeleted = false) — áp dụng Global Query Filter.</p>
    </div>
    @if ((await AuthorizationService.AuthorizeAsync(User, "CanManageProduct")).Succeeded)
    {
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4">
            <i class="bi bi-plus-circle me-1"></i> Thêm vật tư
        </a>
    }
</div>

<!-- Search Bar (Feature 2) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-controller="Supplies" asp-action="Search" class="row g-2 align-items-center">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="keyword" value="@ViewData["keyword"]" 
                           class="form-control border-start-0 rounded-end-3" 
                           placeholder="Tìm kiếm theo Mã vật tư, Tên vật tư hoặc Mô tả..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-grid">
                <button type="submit" class="btn btn-dark rounded-3">Tìm kiếm</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Ảnh</th>
                        <th>Mã vật tư</th>
                        <th>Tên vật tư</th>
                        <th>Danh mục</th>
                        <th>Nhà cung cấp</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsQuarantined ? "table-danger-subtle" : "")">
                            <td class="ps-4">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.SupplyName" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded border text-muted d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="bi bi-image" style="font-size: 1.5rem;"></i>
                                    </div>
                                }
                            </td>
                            <td><code>@item.SupplyCode</code></td>
                            <td>
                                <div class="fw-bold text-dark">@item.SupplyName</div>
                                @if (item.IsQuarantined)
                                {
                                    <small class="text-danger fw-bold d-block"><i class="bi bi-exclamation-triangle-fill"></i> Đang bị cách ly</small>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                            <td class="text-muted small">@item.Supplier</td>
                            <td class="text-end fw-semibold">@item.UnitPrice.ToString("N0") VND</td>
                            <td class="text-center fw-bold">@item.StockQuantity</td>
                            <td class="text-center">
                                @if (item.IsQuarantined)
                                {
                                    <span class="badge-quarantined">⚠ Cách ly</span>
                                }
                                else if (item.Status == "Available")
                                {
                                    <span class="badge-available">✓ Sẵn có</span>
                                }
                                else if (item.Status == "Low Stock")
                                {
                                    <span class="badge-low">⚠ Sắp hết</span>
                                }
                                else
                                {
                                    <span class="badge-out">✗ Hết hàng</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Detail" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if ((await AuthorizationService.AuthorizeAsync(User, "CanAdjustStock")).Succeeded)
                                    {
                                        <a asp-action="AdjustStock" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info" title="Điều chỉnh kho">
                                            <i class="bi bi-sliders"></i>
                                        </a>
                                    }

                                    @if ((await AuthorizationService.AuthorizeAsync(User, "CanManageProduct")).Succeeded)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-box-seam fs-1 d-block mb-3"></i>
                                Không tìm thấy vật tư y tế nào hoạt động.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

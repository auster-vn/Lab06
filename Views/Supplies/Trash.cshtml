@model List<MedicalSuppliesCatalog.Lab06.ViewModels.SupplyTrashItemViewModel>
@{
    ViewData["Title"] = "Thùng rác - Vật tư đã xóa";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold"><i class="bi bi-trash-fill me-2 text-secondary"></i>Thùng rác vật tư y tế</h1>
        <p class="text-muted mb-0">Danh sách các vật tư đã bị xóa mềm. Bạn có thể khôi phục lại bất cứ lúc nào.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary rounded-3 px-4">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách chính
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5 text-center">
            <i class="bi bi-trash2 fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold text-secondary">Thùng rác trống</h5>
            <p class="text-muted mb-0">Không có vật tư nào bị xóa mềm gần đây.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th class="ps-4">Mã vật tư</th>
                            <th>Tên vật tư</th>
                            <th>Danh mục</th>
                            <th>Ngày xóa (UTC)</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="table-light">
                                <td class="ps-4"><code>@item.SupplyCode</code></td>
                                <td class="fw-semibold">@item.SupplyName</td>
                                <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                                <td class="text-muted small">@(item.DeletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="text-center pe-4">
                                    <form asp-controller="Supplies" asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success rounded-3 px-3 fw-semibold shadow-sm">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Khôi phục
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
